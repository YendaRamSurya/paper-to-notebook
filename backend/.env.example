# Lightning AI API key (server-side only; required)
LIGHTNING_API_KEY=your_lightning_api_key_here

# Lightning AI model to use (optional, defaults to lightning-ai/deepseek-v4-pro)
LIGHTNING_MODEL=lightning-ai/deepseek-v4-pro

# Maximum upload size in MB
MAX_UPLOAD_MB=30

# Port (Railway will set this automatically)
PORT=8000
